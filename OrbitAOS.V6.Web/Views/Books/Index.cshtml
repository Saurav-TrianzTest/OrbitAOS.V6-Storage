@model IEnumerable<OrbitAOS.V6.Application.DTOs.BookDto>
@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Books</h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add New Book
    </a>
</div>

<!-- Search and Filter Form -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-5">
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                   class="form-control" placeholder="Search by title, author, or ISBN..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary me-2">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No books found. <a asp-action="Create">Add the first book</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>ISBN</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@(book.ISBN ?? "-")</td>
                        <td>@(book.CategoryName ?? "-")</td>
                        <td>@book.Price.ToString("C")</td>
                        <td>@book.Quantity</td>
                        <td>
                            @if (book.IsAvailable)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted">Total: @Model.Count() book(s)</p>
}
