{
  "ConnectionStrings": {
    // Migrate from web.config <connectionStrings> to appsettings.json.
    // For production, override via environment variable:
    //   ConnectionStrings__DefaultConnection=<value>
    // or Azure Key Vault / AWS Secrets Manager.
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=OrbitAOS_Net10;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Application-specific settings (replaces web.config <appSettings>).
  // Access via IConfiguration or strongly-typed IOptions<T>.
  "AppSettings": {
    "ApplicationName": "OrbitAOS",
    "Version": "10.0.0",
    "SupportEmail": "support@orbitaos.example.com"
  }
}
